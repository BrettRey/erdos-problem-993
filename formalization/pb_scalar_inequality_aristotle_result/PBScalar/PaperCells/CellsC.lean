/-- Cell `[15, 16]` by the paper's route: `Q(H) ≤ S_15 T_15` for `H ∈ [15, 16]`. -/
theorem cell15_paper (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    Qf (15 + t) ≤ Sm (15 + t) 15 * Tm (15 + t) 15 := by
  have h := cell15_numerator t ht0
  rw [cell15_bernstein] at h
  have hs : 0 ≤ 1 - t := by linarith
  have hpos : 0 ≤ 4 * (15 + t) ^ 30 * (Sm (15 + t) 15 * Tm (15 + t) 15 - Qf (15 + t)) := by
    rw [h]; generalize 1 - t = s at hs ⊢; positivity
  have hH : (0 : ℝ) < 4 * (15 + t) ^ 30 := by positivity
  have := (mul_nonneg_iff_of_pos_left hH).mp hpos
  linarith

